# Copier ce fichier en .env.local (jamais commité) et renseigner les valeurs.
# Supabase → Project Settings → API. La clé anon est publique (le RLS protège les données).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Ne jamais mettre ici de clé de fournisseur IA ni la service_role : secrets des Edge Functions uniquement.
